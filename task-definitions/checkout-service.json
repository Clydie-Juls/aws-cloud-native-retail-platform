[
  {
    "name": "checkout",
    "image": "public.ecr.aws/aws-containers/retail-store-sample-checkout:1.3.0",
    "essential": true,

    "portMappings": [
      {
        "name": "checkout",
        "containerPort": 8080,
        "protocol": "tcp"
      }
    ],

    "environment": [
      {
        "name": "RETAIL_CHECKOUT_PERSISTENCE_PROVIDER",
        "value": "redis"
      },
      {
        "name": "RETAIL_CHECKOUT_PERSISTENCE_REDIS_URL",
        "value": "redis://localhost:6379"
      },
      {
        "name": "RETAIL_CHECKOUT_ENDPOINTS_ORDERS",
        "value": "http://orders:8080"
      }
    ],

    "dependsOn": [
      {
        "containerName": "checkout-redis",
        "condition": "HEALTHY"
      }
    ],

    "healthCheck": {
      "command": [
        "CMD-SHELL",
        "curl -f http://localhost:8080/health || exit 1"
      ],
      "interval": 10,
      "timeout": 10,
      "retries": 3
    }
  }
]