[{
    "name": "cart-service",
    "image": "public.ecr.aws/aws-containers/retail-store-sample-cart:1.3.0",
    "essential": true, 
    "portMappings": [
        {
            "name": "cart",
            "containerPort": 8080,
            "protocol": "tcp"
        }
    ],

    "environment": [
      {
        "name": "SERVER_TOMCAT_ACCESSLOG_ENABLED",
        "value": "true"
      },
      {
        "name": "RETAIL_CART_PERSISTENCE_PROVIDER",
        "value": "dynamodb"
      },
      {
        "name": "RETAIL_CART_PERSISTENCE_DYNAMODB_ENDPOINT",
        "value": "http://localhost:8000"
      },
      {
        "name": "RETAIL_CART_PERSISTENCE_DYNAMODB_CREATE_TABLE",
        "value": "true"
      },
      {
        "name": "AWS_ACCESS_KEY_ID",
        "value": "key"
      },
      {
        "name": "AWS_SECRET_ACCESS_KEY",
        "value": "dummy"
      }
    ],

    "healthCheck": {
  "command": [
    "CMD-SHELL",
    "curl -f http://localhost:8080/actuator/health || exit 1"
  ],
  "interval": 10,
  "timeout": 10,
  "retries": 3,
  "startPeriod": 15
},

    "dependsOn": [
        {
            "containerName": "cart-db",
            "condition": "HEALTHY"
        }
    ],

    "readonlyRootFilesystem": true,

    "linuxParameters": {
      "tmpfs": [
        {
          "containerPath": "/tmp",
          "size": 64,
          "mountOptions": [
            "rw",
            "noexec",
            "nosuid"
          ]
        }
      ]
    }
}]